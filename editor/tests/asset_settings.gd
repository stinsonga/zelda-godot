extends SceneTree
const Fixture = preload("authored_art_fixture.gd")
const Library = preload("../shared/authored_library.gd")
const Art = preload("../shared/appearance.gd")
const Pack = preload("../shared/room_pack.gd")
var failures := 0
func check(ok: bool, message: String) -> void:
	if not ok: failures+=1;push_error(message)
func _initialize() -> void:
	create_timer(30).timeout.connect(func(): push_error("Asset settings checks timed out");quit(1))
	call_deferred("run")
func run() -> void:
	var folder := Fixture.create();Fixture.add_clips(folder)
	var id := "art/test_art/clips"
	var loaded := Library.asset_record(folder,id)
	var png := FileAccess.get_file_as_bytes(loaded.image)
	var before := FileAccess.get_file_as_bytes(loaded.manifest)
	check(not Library.update_asset(folder,id,{"file":"outside.png"},loaded.asset).errors.is_empty(),"Image paths cannot change through metadata edits")
	check(not Library.update_asset(folder,id,{"frame_size":[16,25]},loaded.asset).errors.is_empty(),"Frame layout must still match existing image dimensions")
	check(FileAccess.get_file_as_bytes(loaded.manifest)==before,"Rejected settings leave library unchanged")
	check(not Library.asset_record(folder,"rom/us_prg0/clips").errors.is_empty() and not Library.asset_record(folder,"art/../clips").errors.is_empty(),"ROM and traversal IDs are rejected")
	var changed := Library.update_asset(folder,id,{"name":"Renamed actor","draw_offset":[-2,-10]},loaded.asset)
	check(changed.errors.is_empty(),"Existing sprite settings save")
	check(FileAccess.get_file_as_bytes(loaded.image)==png,"Metadata save preserves PNG bytes")
	check(not Library.update_asset(folder,id,{"name":"Stale form"},loaded.asset).errors.is_empty(),"Stale form cannot overwrite selected asset")
	var current := Library.asset_record(folder,id)
	var other := Library.asset_record(folder,"art/test_art/tiles")
	check(Library.update_asset(folder,"art/test_art/tiles",{"name":"New tiles","cell_size":16},other.asset).errors.is_empty(),"Existing tile grid and name are editable")
	check(Library.update_asset(folder,id,{"draw_size":[20,30]},current.asset).errors.is_empty(),"Unrelated asset edits do not block current settings")
	check(Library.asset_record(folder,"art/test_art/tiles").asset.name=="New tiles","Latest unrelated asset edits are preserved")
	var resolver = Art.new();resolver.configure(folder)
	check(resolver.sprite_layout(id)==Rect2(-2,-10,20,30),"Resolver reloads edited geometry under same ID")
	var ui = preload("../ui/main.tscn").instantiate();root.add_child(ui)
	ui.game_root = folder;ui.asset_library.load_catalog(folder)
	var pack := Fixture.pack();pack.appearance.enemy_sprites.crawler = id;ui.replace_pack(pack,"",false)
	ui.asset_library.search.text = "Renamed actor";ui.asset_library.populate();ui.asset_library.select_image(0)
	check(not ui.asset_library.edit_settings.disabled,"Authored selection enables settings editor")
	var original_pack: Dictionary = ui.pack.duplicate(true)
	var dialog = ui.asset_library.importer;dialog.open_asset(folder,id)
	check(dialog.edit_id==id and not dialog.asset_id.editable and dialog.kind.disabled and dialog.browse.disabled,"Settings form locks identity, kind and PNG source")
	check(dialog.offset_y.value== -10 and dialog.clip_controls.attack.enabled.button_pressed,"Settings form restores geometry and named clips")
	dialog.display_name.text = "Edited actor";dialog.draw_width.value = 16;dialog.draw_height.value = 24;dialog.offset_x.value = 0;dialog.offset_y.value = -8
	dialog.clip_controls.walk.ticks.value = 12;dialog.import_asset()
	check(dialog.result_text.text.begins_with("Saved art/test_art/clips"),"GUI saves existing asset")
	check(ui.asset_library.selected_entry.get("id")==id and ui.asset_library.selected_entry.name.ends_with("Edited actor"),"Browser refresh preserves selection even when old name filter stops matching")
	check(ui.canvas.enemy_layouts.crawler==Rect2(0,-8,16,24) and int(ui.canvas.enemy_sprite_clips.crawler.walk.frame_ticks)==12,"Edited geometry and timing refresh in room preview")
	check(ui.pack==original_pack and not ui.dirty(),"Library editing leaves pack and document undo state unchanged")
	check(FileAccess.get_file_as_bytes(loaded.image)==png,"GUI metadata edit never writes PNG")
	dialog.clip_controls.idle.ticks.value = 11;dialog.import_asset()
	check(dialog.result_text.text.begins_with("Saved"),"Second save uses refreshed asset snapshot")
	dialog.hide();dialog.open_import(folder)
	check(dialog.edit_id.is_empty() and dialog.source.editable and not dialog.kind.disabled and not dialog.display_name.get_parent().visible,"Import mode resets locked editing controls")
	dialog.hide();dialog.open_asset(folder,"art/test_art/missing")
	check(dialog.apply_button.disabled,"Missing asset cannot accidentally save previous form")
	ui.free()
	var final_asset := Library.asset_record(folder,id)
	var directory := DirAccess.open(final_asset.manifest.get_base_dir())
	var link_error := directory.create_link(final_asset.manifest,final_asset.manifest+".tmp")
	check(link_error==OK and not Library.update_asset(folder,id,{"name":"Linked"},final_asset.asset).errors.is_empty(),"Linked manifest temporary file is rejected")
	DirAccess.remove_absolute(final_asset.manifest+".tmp")
	var image := Image.create(16,16,false,Image.FORMAT_RGBA8);image.save_png(final_asset.image)
	check(not Library.update_asset(folder,id,{"name":"Changed PNG"},final_asset.asset).errors.is_empty(),"Changed PNG dimensions require restoration or a new import")
	Fixture.remove(folder)
	print("Asset settings editor checks: ","PASS" if failures==0 else "FAIL");quit(0 if failures==0 else 1)
