extends SceneTree
const Pack = preload("../shared/room_pack.gd")
const Art = preload("../shared/appearance.gd")
const Fixture = preload("authored_art_fixture.gd")
var failures := 0
func check(ok: bool, message: String) -> void:
	if not ok: failures+=1;push_error(message)
func _initialize() -> void:
	create_timer(30).timeout.connect(func(): push_error("Room rename checks timed out");quit(1))
	call_deferred("run")
func run() -> void:
	var source := Fixture.pack();source.goals = [{"room":"vault","pickup":"reward"}]
	var overlay := Art.fresh(source.id);overlay.room_tiles.entry = source.appearance.room_tiles.entry.duplicate(true);overlay.room_tiles.entry.atlas = "rom/us_prg0/levels/test"
	var original: Dictionary = source.duplicate(true);var old_art: Dictionary = overlay.duplicate(true)
	var renamed := Pack.rename_room(source,"entry","landing",overlay)
	check(renamed.errors.is_empty(),"Room rename validates")
	check(source==original and overlay==old_art,"Rename leaves inputs unchanged")
	check(renamed.pack.start_room=="landing" and renamed.pack.rooms[1].connections.down.target=="landing","Start and reciprocal door references update")
	check(renamed.pack.appearance.room_tiles.has("landing") and renamed.pack.appearance.room_sprites.has("landing") and renamed.appearance.room_tiles.has("landing"),"Shared and private appearance move together")
	check(not JSON.stringify(renamed.pack).contains("rom/us_prg0"),"Private art never enters shared pack")
	var end := Pack.rename_room(renamed.pack,"vault","finish",renamed.appearance)
	check(end.errors.is_empty() and end.pack.rooms[0].stairs[0].target=="finish" and end.pack.goals[0].room=="finish","Stairs and objective references update")
	var again := Pack.rename_room(end.pack,"landing","foyer",end.appearance)
	check(again.errors.is_empty() and again.pack.room_aliases.entry=="foyer" and again.pack.room_aliases.landing=="foyer","Repeated renames flatten all aliases to current identity")
	for invalid in ["entry","landing","finish","../unsafe","INVALID",""]:
		check(not Pack.rename_room(again.pack,"foyer",invalid,again.appearance).errors.is_empty(),"Live/reserved/invalid IDs are rejected: "+invalid)
	var legacy := Pack.rename_room(Pack.sample(),"entry","start")
	check(legacy.errors.is_empty() and legacy.pack.schema==2 and legacy.pack.starting_items==["wooden_sword"],"Renaming upgrades a legacy pack without changing loadout")
	var bad: Dictionary = source.duplicate(true);bad.room_aliases = {"a":"b","b":"entry"}
	check(not Pack.validate(bad).is_empty(),"Chained alias data rejected")
	bad.room_aliases = {"entry":"entry"};check(not Pack.validate(bad).is_empty(),"Historical name cannot also be live")
	bad.room_aliases = {"retired":""};check(Pack.validate(bad).is_empty(),"Deleted-room markers are supported")
	var game_root := ProjectSettings.globalize_path("res://").trim_suffix("/").get_base_dir()
	var graph := Pack.read(game_root.path_join("content/packs/looped_dungeon.json"))
	var record: Dictionary = graph.pack.generation.loop_edges[0]
	var graph_rename := Pack.rename_room(graph.pack,record.room,"loop_chamber")
	check(graph_rename.errors.is_empty() and graph_rename.pack.generation.templates.has("loop_chamber") and graph_rename.pack.generation.loop_edges[0].room=="loop_chamber","Generation provenance follows semantic room rename")
	var folder := Fixture.create();var filename := folder.path_join("renamed.json")
	var private_path := Art.local_path(folder,source.id);DirAccess.make_dir_recursive_absolute(private_path.get_base_dir());Pack.write(private_path,overlay)
	var disk_before := FileAccess.get_file_as_bytes(private_path)
	var migrated := Art.read_local(folder,renamed.pack)
	check(migrated.warnings.is_empty() and migrated.overlay.room_tiles.has("landing"),"Stale private overlay resolves shared room aliases")
	check(FileAccess.get_file_as_bytes(private_path)==disk_before,"Reading migrated local art never rewrites its file")
	var ui = preload("../ui/main.tscn").instantiate();root.add_child(ui);ui.game_root = folder;ui.replace_pack(source,"",false);ui.appearance = overlay.duplicate(true)
	ui.select_placement("pickups","entry_key")
	check(ui.rename_current_room("landing"),"GUI rename action succeeds")
	check(ui.current_id=="landing" and ui.placement_key.room=="landing" and ui.room_id_edit.text=="landing","Room and selected placement stay selected after rename")
	ui.undo();check(ui.current_id=="entry" and ui.pack==source and ui.appearance==overlay and ui.placement_key.room=="entry","One undo restores references, aliases, artwork and selection")
	ui.redo();check(ui.current_id=="landing" and ui.pack.room_aliases.entry=="landing","Redo restores rename and selection")
	check(ui.save_to(filename) and Pack.read(filename).pack.room_aliases.entry=="landing","Aliases persist in shared JSON")
	check(Art.read_local(folder,ui.pack).overlay.room_tiles.has("landing"),"Save persists private appearance separately")
	ui.delete_room()
	check(ui.pack.room_aliases.entry=="" and ui.pack.room_aliases.landing=="" and Pack.validate(ui.pack).is_empty(),"Deleting renamed content reserves the whole identity history")
	check(not Pack.rename_room(ui.pack,ui.current_id,"entry").errors.is_empty(),"Deleted historical ID cannot identify a different room")
	ui.undo();check(ui.pack.room_aliases.entry=="landing","Undo deletion restores usable migration")
	ui.replace_pack(Pack.sample(),"",false);ui.rename_current_room("room_1")
	ui.rename_current_room("foyer")
	check(ui.unique_room_id()!="room_1","New rooms skip reserved historical IDs")
	ui.free();Fixture.remove(folder)
	print("Room renaming editor checks: ","PASS" if failures==0 else "FAIL");quit(0 if failures==0 else 1)
