extends SceneTree
const Fixture = preload("authored_art_fixture.gd")
const Pack = preload("../shared/room_pack.gd")
const Art = preload("../shared/appearance.gd")
const Importer = preload("../shared/authored_library.gd")
var failures := 0
func check(ok: bool, message: String) -> void:
	if not ok: failures+=1;push_error(message)
func _initialize() -> void:
	create_timer(30).timeout.connect(func(): push_error("Authored art test timed out");quit(1))
	call_deferred("run")
func run() -> void:
	var folder := Fixture.create()
	var pack := Fixture.pack()
	check(Pack.validate(pack).is_empty(),"Public authored bindings validate: "+str(Pack.validate(pack)))
	var malformed: Dictionary = pack.duplicate(true);malformed.rooms[0].stairs = 42
	check(not Pack.validate(malformed).is_empty(),"Malformed feature data is diagnosed before rendering")
	var library = Art.new();library.configure(folder)
	check(library.entries.size()==2 and library.groups.size()==1,"Authored library works without a ROM catalog")
	var sprite: Texture2D = library.enemy_texture("art/test_art/beast","left",1)
	check(sprite.get_size()==Vector2(32,32) and sprite.get_image().get_pixel(1,1)==Color.CYAN,"Direction/frame crop retains full 32px resolution")
	var terrain: Texture2D = library.room_texture(pack.rooms[0],Art.effective(pack))
	check(terrain.get_size()==Vector2(512,352) and terrain.get_image().get_pixel(97,97)==Color.BLUE,"32px atlas cells compose without downsampling")
	var manifest := folder.path_join("content/art/test_art/library.json")
	var original := FileAccess.get_file_as_bytes(manifest)
	check(not Importer.import_png(folder,folder.path_join("source.png"),"test_art","tiles","tiles",32).errors.is_empty(),"Duplicate IDs are rejected")
	check(FileAccess.get_file_as_bytes(manifest)==original,"Rejected duplicate preserves manifest")
	check(not Importer.import_png(folder,folder.path_join("source.png"),"../escape","bad","tiles",32).errors.is_empty(),"Traversal IDs rejected")
	check(not Importer.import_png(folder,folder.path_join("source.png"),"test_art","bad","sprite",32,["all"],3).errors.is_empty(),"Mismatched sprite dimensions rejected")
	DirAccess.make_dir_recursive_absolute(folder.path_join("imported"))
	var image := Image.load_from_file(folder.path_join("source.png"));image.save_png(folder.path_join("imported/copied.png"))
	check(not Importer.import_png(folder,folder.path_join("imported/copied.png"),"test_art","copied","tiles",32).errors.is_empty(),"Local ROM import directory cannot supply a public library")
	var alias_path := folder.path_join("alias.png")
	var link_error := DirAccess.open(folder).create_link(folder.path_join("imported/copied.png"),alias_path)
	check(link_error==OK,"Fixture creates a source alias")
	check(not Importer.import_png(folder,alias_path,"test_art","alias","tiles",32).errors.is_empty(),"Symlink source cannot bypass private-import boundary")
	var output_directory := DirAccess.open(folder.path_join("content/art/test_art"))
	link_error = output_directory.create_link(manifest,folder.path_join("content/art/test_art/library.json.tmp"))
	check(link_error==OK,"Fixture creates a manifest temporary-file alias")
	check(not Importer.import_png(folder,folder.path_join("source.png"),"test_art","linked","tiles",32).errors.is_empty(),"Symlink output rejected without modifying manifest")
	check(FileAccess.get_file_as_bytes(manifest)==original,"Rejected output alias preserves library")
	DirAccess.remove_absolute(folder.path_join("content/art/test_art/library.json.tmp"))
	var invalid: Dictionary = pack.duplicate(true);invalid.appearance.enemy_sprites.crawler = "rom/us_prg0/test_beast"
	check(not Pack.validate(invalid).is_empty(),"Public bindings reject ROM IDs")
	var ui = preload("../ui/main.tscn").instantiate();root.add_child(ui)
	ui.game_root = folder;ui.asset_library.load_catalog(folder);ui.replace_pack(pack,"",false)
	ui.appearance.enemy_sprites.crawler = "rom/us_prg0/test_beast"
	check(ui.effective_art().enemy_sprites.crawler=="rom/us_prg0/test_beast","Enabled local choice overrides public binding")
	ui.apply_enemy_art("art/test_art/beast")
	check(not ui.appearance.enemy_sprites.has("crawler"),"Choosing authored skin clears private override")
	ui.local_art.button_pressed = false
	check(ui.canvas.visual_texture != null and ui.canvas.enemy_sprite_frames.crawler.size()==2,"Disabling local ROM art retains shared authored art")
	ui.choose_tile_brush("art/test_art/tiles",0)
	var before: Dictionary = ui.pack.duplicate(true);var before_art: Dictionary = ui.appearance.duplicate(true)
	ui.paint(Vector2i(4,3),false);ui.commit(before,before_art)
	check(ui.pack.rooms[0].tiles==pack.rooms[0].tiles and ui.pack.appearance.room_tiles.entry.indices[52]==0,"Public art brush preserves terrain")
	ui.undo();check(ui.pack==pack,"Undo restores public art")
	ui.redo();check(ui.pack.appearance.room_tiles.entry.indices[52]==0,"Redo restores public art stroke")
	ui.duplicate_room();check(ui.pack.appearance.room_tiles.has(ui.current_id) and ui.pack.appearance.room_sprites.has(ui.current_id),"Duplicate room preserves authored bindings")
	ui.undo();ui.select_room("entry")
	ui.apply_room_sprite("secret","art/test_art/beast")
	ui.edit(func(): ui.current().erase("secret"))
	check(not ui.pack.appearance.room_sprites.entry.has("secret"),"Deleting feature prunes its art")
	ui.undo();check(ui.pack.appearance.room_sprites.entry.has("secret"),"Undo restores feature art")
	var filename := folder.path_join("public.json")
	check(ui.save_to(filename),"Public art pack saves")
	check(JSON.parse_string(FileAccess.get_file_as_string(filename)).appearance.room_sprites.entry.secret=="art/test_art/beast","Shared JSON retains portable authored IDs")
	ui.asset_library.search.text = "tiles";ui.asset_library.populate();ui.asset_library.select_image(0)
	check(ui.asset_library.preview.cell_size==32,"Tile picker uses authored grid size")
	var preview: Control = ui.asset_library.preview;preview.size = Vector2(320,200)
	var rect: Rect2 = preview.image_rect();var event := InputEventMouseButton.new();event.button_index = MOUSE_BUTTON_LEFT;event.pressed = true;event.position = rect.position+rect.size*Vector2(0.75,0.5)
	preview._gui_input(event);check(preview.selected_tile==1,"32px atlas picking resolves correct source tile")
	ui.free()
	DirAccess.remove_absolute(folder.path_join("content/art/test_art/beast.png"))
	library.configure(folder)
	check(library.enemy_texture("art/test_art/beast")==null and not library.warnings.is_empty(),"Missing authored PNG produces fallback diagnostic")
	Fixture.remove(folder)
	print("Authored art editor checks: ","PASS" if failures==0 else "FAIL");quit(0 if failures==0 else 1)
