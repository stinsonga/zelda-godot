extends SceneTree
const Pack = preload("../shared/room_pack.gd")
const Art = preload("../shared/appearance.gd")
const Fixture = preload("appearance_fixture.gd")
var failures := 0
func check(ok: bool, text: String) -> void:
	if not ok: failures += 1; push_error(text)
func _initialize() -> void:
	create_timer(30).timeout.connect(func(): push_error("Appearance editor checks timed out"); quit(1))
	call_deferred("run")
func run() -> void:
	var fixture := Fixture.create()
	var library = Art.new()
	library.configure(fixture)
	check(library.groups.size() == 1,"Directional frames group into one sprite set")
	check(library.enemy_texture("rom/us_prg0/test_beast","left",1).get_image().get_pixel(1,1) == Color.BLUE,"Selected direction and animation frame resolve")
	var ui = preload("../ui/main.tscn").instantiate()
	root.add_child(ui)
	ui.game_root = fixture
	ui.asset_library.load_catalog(fixture)
	var source := Pack.sample()
	source.id = "appearance_lab"
	ui.replace_pack(source,"",false)
	ui.apply_enemy_art("rom/us_prg0/test_beast")
	check(ui.pack == source and ui.appearance.enemy_sprites.crawler == "rom/us_prg0/test_beast","Enemy appearance does not mutate behavior data")
	check(ui.dirty() and ui.canvas.enemy_textures.has("crawler"),"Appearance changes mark document dirty and draw local sprite")
	ui.undo()
	check(ui.appearance.enemy_sprites.is_empty(),"Undo removes sprite assignment")
	ui.redo()
	check(ui.appearance.enemy_sprites.has("crawler"),"Redo restores sprite assignment")
	ui.choose_tile_brush("rom/us_prg0/levels/test",1)
	var before: Dictionary = ui.pack.duplicate(true)
	var before_art: Dictionary = ui.appearance.duplicate(true)
	ui.paint(Vector2i(3,3),false)
	ui.paint(Vector2i(4,3),false)
	ui.paint(Vector2i(0,0),false)
	ui.commit(before,before_art)
	check(ui.pack == source and ui.appearance.room_tiles.entry.indices[51] == 1,"Art stroke paints selected tiles without changing collision text")
	check(ui.canvas.visual_texture.get_image().get_pixel(49,49) == Color.BLUE,"Editor renders selected atlas tile exactly")
	ui.undo()
	check(ui.appearance.room_tiles.is_empty(),"One undo removes complete art stroke")
	ui.redo()
	check(ui.appearance.room_tiles.entry.indices[52] == 1,"Redo restores complete art stroke")
	check(Art.validate(ui.appearance,ui.pack).is_empty(),"Local art choices validate separately")
	ui.choose_tile_brush("rom/us_prg0/levels/test",0)
	before = ui.pack.duplicate(true)
	before_art = ui.appearance.duplicate(true)
	ui.paint(Vector2i(3,3),true)
	ui.commit(before,before_art)
	check(ui.appearance.room_tiles.entry.indices[51] == -1,"Right-click removes just that cell's art")
	ui.undo()
	ui.duplicate_room()
	check(ui.appearance.room_tiles.has(ui.current_id),"Room duplication copies local art under new stable ID")
	ui.undo()
	ui.select_room("entry")
	ui.delete_room()
	check(not ui.appearance.room_tiles.has("entry"),"Room deletion removes its local art")
	ui.undo()
	check(ui.appearance.room_tiles.has("entry"),"Undo deletion restores local art")
	var filename := fixture.path_join("authored.json")
	check(ui.save_to(filename),"Pack and private appearance save")
	var text := FileAccess.get_file_as_string(filename)
	check(not text.contains("rom/us_prg0") and not text.contains("enemy_sprites"),"Shared pack contains no ROM appearance references")
	var overlay_path := Art.local_path(fixture,ui.pack.id)
	check(FileAccess.file_exists(overlay_path),"Local choices saved outside generated import")
	var restored := Art.read_local(fixture,ui.pack)
	check(restored.warnings.is_empty() and restored.overlay.enemy_sprites.crawler == "rom/us_prg0/test_beast","Private choices load after reopening")
	ui.replace_pack(source,filename)
	check(ui.appearance.room_tiles.has("entry") and not ui.dirty(),"Opening pack restores local overlay without dirtying it")
	DirAccess.rename_absolute(fixture.path_join("imported"),fixture.path_join("old-import"))
	Fixture.populate(fixture)
	check(Art.read_local(fixture,source).overlay.enemy_sprites.has("crawler"),"Reimport replacement cannot erase local choices")
	var invalid: Dictionary = ui.appearance.duplicate(true)
	invalid.source_sha1 = "wrong"
	Pack.write(overlay_path,invalid)
	ui.replace_pack(source,filename)
	check(ui.appearance.enemy_sprites.is_empty() and not ui.appearance_load_warnings.is_empty(),"Incompatible overlay falls back with warning")
	ui.save_to(filename)
	check(FileAccess.get_file_as_string(overlay_path).contains("wrong"),"Ordinary pack save preserves an unreadable unchanged overlay")
	ui.asset_library.search.text = "test beast"
	ui.asset_library.populate()
	check(ui.asset_library.shown.size() == 1,"Browser presents one grouped monster choice")
	ui.asset_library.select_image(0)
	check(not ui.asset_library.enemy_apply.disabled,"Sprite set can be explicitly assigned")
	ui.asset_library.preview.texture = ui.asset_library.library.texture("rom/us_prg0/levels/test")
	ui.asset_library.preview.tile_mode = true
	ui.asset_library.preview.size = Vector2(320,200)
	var rect: Rect2 = ui.asset_library.preview.image_rect()
	var event := InputEventMouseButton.new()
	event.button_index = MOUSE_BUTTON_LEFT
	event.pressed = true
	event.position = rect.position+rect.size*Vector2(0.75,0.5)
	ui.asset_library.preview._gui_input(event)
	check(ui.asset_library.preview.selected_tile == 1,"Atlas picking accounts for preview scale and margins")
	ui.free()
	Fixture.remove(fixture)
	print("Appearance editor checks: ","PASS" if failures == 0 else "FAIL")
	quit(0 if failures == 0 else 1)
